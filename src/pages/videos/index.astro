---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Toc from "../../components/Toc.astro";
import VideoCard from "../../components/VideoCard.astro";
import { getVideos, getTags } from "../../lib/site";

const PARACORD = "Jacob's Paracord Corner";
const TECH = "Jacob Turner - Tech";

const all = await getVideos();
const paracord = all.filter((v) => v.data.channel === PARACORD);
const tech = all.filter((v) => v.data.channel === TECH);
const other = all.filter(
  (v) => v.data.channel !== PARACORD && v.data.channel !== TECH,
);
const tags = await getTags();
---

<BaseLayout title="Videos" rss="/videos/index.xml">
  <div class="content-with-sidebar">
    <div class="main-content-flow" id="page-content">
      <div class="videos-page-header">
        <h1>Videos</h1>
        <p class="lead">
          Browse all video tutorials and guides, separated by channel and topic.
        </p>
      </div>

      <div class="search-filter-bar" id="search-and-filters">
        <div class="search-input-wrapper">
          <span class="search-icon">🔍</span>
          <input
            type="search"
            id="video-search-input"
            placeholder="Search by title, knot, tag, or topic..."
            aria-label="Search videos"
          />
          <button
            id="clear-search-btn"
            class="clear-btn"
            style="display:none;"
            aria-label="Clear search">✕</button
          >
        </div>

        <div class="filter-pills" id="channel-filters">
          <button type="button" class="filter-btn active" data-filter="all"
            >All Videos ({all.length})</button
          >
          <button type="button" class="filter-btn" data-filter="paracord"
            >🪢 Paracord ({paracord.length})</button
          >
          <button type="button" class="filter-btn" data-filter="tech"
            >💻 Linux &amp; Tech ({tech.length})</button
          >
          <button type="button" class="filter-btn" data-filter="tutorial"
            >Tutorials</button
          >
          <button type="button" class="filter-btn" data-filter="showcase"
            >Showcases</button
          >
        </div>
      </div>

      <div class="results-meta-bar" id="video-results-meta">
        <span id="results-count-text"
          >Showing all {all.length} videos across categories</span
        >
      </div>

      <section class="video-category-section" id="paracord-videos">
        <div class="category-header">
          <div class="category-title-wrap">
            <span class="category-icon">🪢</span>
            <div>
              <h2>Paracord Tutorials &amp; Showcases</h2>
              <p class="category-desc">
                Bracelets, knot tutorials, cores, and weaves from <strong
                  >Jacob's Paracord Corner</strong
                >.
              </p>
            </div>
          </div>
          <a
            class="btn btn-ghost btn-sm"
            href="https://www.youtube.com/@JacobTurner-p1f9c?sub_confirmation=1"
            target="_blank"
            rel="noopener">Subscribe on YouTube ↗</a
          >
        </div>
        <div class="grid video-grid">
          {
            paracord.length > 0 ? (
              paracord.map((v) => <VideoCard video={v} />)
            ) : (
              <p class="empty-section-notice">No paracord videos yet.</p>
            )
          }
        </div>
      </section>

      <section class="video-category-section" id="tech-videos">
        <div class="category-header">
          <div class="category-title-wrap">
            <span class="category-icon">💻</span>
            <div>
              <h2>Linux &amp; Tech Guides</h2>
              <p class="category-desc">
                Arch Linux &amp; Linux guides, software setups, PC hardware, and
                tutorials from <strong>Jacob Turner - Tech</strong>.
              </p>
            </div>
          </div>
          <a
            class="btn btn-ghost btn-sm"
            href="https://www.youtube.com/@jacobturner25?sub_confirmation=1"
            target="_blank"
            rel="noopener">Subscribe on YouTube ↗</a
          >
        </div>
        <div class="grid video-grid">
          {
            tech.length > 0 ? (
              tech.map((v) => <VideoCard video={v} />)
            ) : (
              <p class="empty-section-notice">No tech videos yet. Stay tuned!</p>
            )
          }
        </div>
      </section>

      {
        other.length > 0 && (
          <section class="video-category-section" id="other-videos">
            <div class="category-header">
              <div class="category-title-wrap">
                <span class="category-icon">🎬</span>
                <div>
                  <h2>Other Videos</h2>
                </div>
              </div>
            </div>
            <div class="grid video-grid">
              {other.map((v) => (
                <VideoCard video={v} />
              ))}
            </div>
          </section>
        )
      }

      <div id="no-search-results" class="empty-results-box" style="display:none;">
        <p class="empty-title">No videos found</p>
        <p class="empty-sub">
          Try searching for something else like "cobra", "boxbuddy", or
          "bracelet".
        </p>
        <button type="button" id="reset-search-btn" class="btn btn-ghost"
          >Reset Filters</button
        >
      </div>

      {
        tags.length > 0 && (
          <div class="tag-cloud-section" id="browse-by-tag">
            <h2>Browse by Tag</h2>
            <div class="chips" aria-label="Filter by tag">
              {tags.map((t) => (
                <a class="chip" href={`/tags/${t.slug}/`}>
                  #{t.title} <span>{t.videos.length}</span>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
    <Toc />
  </div>
</BaseLayout>
